# Copy to .env for local development. Every value has a safe local default, so .env is optional.

# SQLite file by default; docker compose and production use PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://nexusflow:nexusflow@localhost:5432/nexusflow
DATABASE_URL=sqlite:///./nexusflow.db

# Leave empty to use the in-process cache. With Redis: redis://localhost:6379/0
REDIS_URL=

# Signs access tokens. Production needs its own long random value, generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-0000

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Refresh-token cookie. Production over HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
